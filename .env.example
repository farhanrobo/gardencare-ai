# Copy this file to `.env.local` for local development.
# NEVER commit real values — `.env*` is git-ignored (this example file is the
# only exception).

# Server-only: used by the /api/cloud route (Supabase backup).
# No NEXT_PUBLIC_ prefix means these are never bundled into the browser.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SECRET_KEY=<your-supabase-secret-key>
